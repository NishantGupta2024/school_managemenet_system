{
  "name": "school-fee-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant School Fee Management System",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "staging:migrate": "npm run staging:migrate --workspace=backend",
    "db:seed": "npm run prisma:seed --workspace=backend",
    "db:generate": "npm run prisma:generate --workspace=backend"
  },
  "keywords": [
    "school-fee-management",
    "multi-tenant",
    "nestjs",
    "react",
    "prisma",
    "postgresql"
  ],
  "author": "Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.1"
  },
  "overrides": {
    "multer": "2.5.0",
    "type-is": "^2.1.0",
    "follow-redirects": "^1.16.2",
    "postcss-selector-parser": "^6.1.5",
    "deepmerge-ts": "^8.0.2",
    "tinypool": "^2.1.2",
    "@vitest/mocker": "^4.1.12",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@nestjs/cli": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "glob@14.0.4": {
      "minimatch": "^11.0.5"
    }
  }
}
