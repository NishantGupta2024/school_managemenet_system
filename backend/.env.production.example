# ==============================================================================
# SCHOOL FEE MANAGEMENT SYSTEM — PRODUCTION ENVIRONMENT TEMPLATE (.env)
# ==============================================================================
# IMPORTANT:
# - This template defines all environment variables utilized across the backend.
# - DO NOT commit real secrets, passwords, or private keys to source control.
# - In production, inject these variables via secure secret managers (e.g. AWS Secrets
#   Manager, HashiCorp Vault, Kubernetes Secrets, or Docker Compose secret files).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED] Active deployment environment. Must be set to 'production'.
NODE_ENV=production

# [REQUIRED] TCP port on which the NestJS HTTP listener binds.
PORT=3000

# [OPTIONAL] Global API routing prefix. Default: /api/v1
API_PREFIX=/api/v1

# [REQUIRED] Allowed CORS origins for the browser frontend.
# Comma-separated list of fully qualified domains (no trailing slashes).
# Example: https://fees.schoolname.edu,https://admin.schoolname.edu
CORS_ORIGIN=https://fees.schoolname.edu

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE & PRISMA CONNECTION POOL
# ------------------------------------------------------------------------------
# [REQUIRED] Primary PostgreSQL connection string.
# Ensure SSL mode is enabled (sslmode=require or verify-full) and connection pool
# parameters (connection_limit, pool_timeout) are tuned for container capacity.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public&sslmode=require&connection_limit=20
DATABASE_URL=postgresql://fee_app_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres.internal:5432/fee_production?schema=public&sslmode=require&connection_limit=25

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION MANAGEMENT (JWT)
# ------------------------------------------------------------------------------
# [REQUIRED] Cryptographic secret used to sign and verify HMAC SHA-256 JWT access tokens.
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_BASE64_JWT_SECRET_MIN_64_CHARS

# [OPTIONAL] Access token time-to-live. Default: 15m (recommended for production).
JWT_EXPIRES_IN=15m

# [OPTIONAL] Refresh token time-to-live in days. Default: 7d.
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY ENCRYPTION & MODE SEPARATION (RAZORPAY)
# ------------------------------------------------------------------------------
# [REQUIRED] 32-byte (64 hex characters) cryptographic master key for AES-256-GCM.
# Used by CryptoService to encrypt per-tenant Razorpay Key Secrets and Webhook Secrets at rest.
# Generate with: openssl rand -hex 32
GATEWAY_ENCRYPTION_KEY=REPLACE_WITH_EXACT_64_CHAR_HEX_STRING_FOR_AES_256_GCM

# [REQUIRED FOR LIVE PAYMENTS] Production Safety Gate Flag.
# Default: false (or unset).
# Must be explicitly set to 'true' to permit schools to configure and transact using
# live Razorpay credentials (rzp_live_*). If false or unset, LIVE mode fails closed.
ALLOW_LIVE_PAYMENT_GATEWAY=false

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & NOTIFICATIONS (SMTP / MAILTRAP)
# ------------------------------------------------------------------------------
# [REQUIRED] Email delivery provider. In production, must be set to 'smtp'.
EMAIL_PROVIDER=smtp

# [REQUIRED] Outbound SMTP host.
# For Mailtrap Transactional Stream: live.smtp.mailtrap.io (or send.smtp.mailtrap.io)
SMTP_HOST=live.smtp.mailtrap.io

# [REQUIRED] SMTP port. Recommended: 587 (Explicit STARTTLS) or 465 (Implicit TLS).
SMTP_PORT=587

# [OPTIONAL] Set to 'true' for port 465 (implicit TLS); 'false' for port 587 (STARTTLS).
SMTP_SECURE=false

# [OPTIONAL] Enforce STARTTLS upgrade before sending credentials. Default: true.
SMTP_REQUIRE_TLS=true

# [REQUIRED] SMTP Authentication Username / API Token.
SMTP_USER=REPLACE_WITH_MAILTRAP_TRANSACTIONAL_API_USER

# [REQUIRED] SMTP Authentication Password / API Secret.
SMTP_PASS=REPLACE_WITH_MAILTRAP_TRANSACTIONAL_API_PASSWORD

# [OPTIONAL] Socket timeout in milliseconds. Default: 15000 (15s).
SMTP_TIMEOUT_MS=15000

# [REQUIRED] Envelope sender email address. Must belong to an account-verified domain
# with passing SPF, DKIM, and DMARC DNS records.
EMAIL_FROM_ADDRESS=notifications@mail.schoolname.edu

# [OPTIONAL] Default display name in From: header.
EMAIL_DEFAULT_FROM_NAME=School Fee Management System

# [REQUIRED TO ACTIVATE] Background outbox worker toggle. Default: false.
# Set to 'true' in the designated background worker instance to process notification queues.
NOTIFICATION_WORKER_ENABLED=false

# [OPTIONAL] Notification worker batch size (1-100). Default: 10.
NOTIFICATION_WORKER_BATCH_SIZE=10

# [OPTIONAL] Notification worker polling interval in milliseconds. Default: 5000 (5s).
NOTIFICATION_WORKER_INTERVAL_MS=5000

# [OPTIONAL] Outbox processing lease duration in milliseconds. Default: 300000 (5m).
NOTIFICATION_WORKER_LOCK_DURATION_MS=300000

# [OPTIONAL] Max retry attempts for transient delivery failures. Default: 5.
NOTIFICATION_MAX_ATTEMPTS=5

# [REQUIRED TO ACTIVATE] Fee reminder scheduler toggle. Default: false.
# Set to 'true' in exactly one scheduler instance to scan and produce daily reminder emails.
FEE_REMINDER_SCHEDULER_ENABLED=false

# [OPTIONAL] UTC hour at which the daily fee reminder scan triggers (0-23). Default: 2 (07:30 AM IST).
FEE_REMINDER_SCHEDULE_HOUR_UTC=2

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING & REDIS COORDINATION
# ------------------------------------------------------------------------------
# [REQUIRED IF RUNNING MULTI-CONTAINER CLUSTER] Redis connection URL.
# Required by MailtrapRateLimiter to coordinate atomic token bucket dispatch (1 email/sec)
# across multiple concurrent worker instances using atomic Lua scripts.
# If unset, rate limiting operates in single-process IN-MEMORY mode only.
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis.internal:6379/0

# [OPTIONAL] Redis key prefix for rate limiter state. Default: schoolfee:ratelimit:email
REDIS_RATE_LIMIT_PREFIX=schoolfee:ratelimit:email

# ------------------------------------------------------------------------------
# 7. AUTOMATED DATABASE BACKUPS & DISASTER RECOVERY
# ------------------------------------------------------------------------------
# [REQUIRED] Directory path where encrypted PostgreSQL database dumps are stored.
# Mount this directory to a persistent, replicated network volume (e.g. AWS EFS, persistent disk).
DATABASE_BACKUP_DIRECTORY=/var/backups/fee_database

# [REQUIRED] 32-byte (64 hex characters) cryptographic encryption key for AES-256-GCM backup archives.
# Generate with: openssl rand -hex 32
DATABASE_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_EXACT_64_CHAR_HEX_STRING_FOR_BACKUP_ENCRYPTION

# [OPTIONAL] Cron schedule for automated database backup execution (5-part cron syntax).
# Default: '0 2 * * *' (02:00 AM UTC / 07:30 AM IST daily).
DATABASE_BACKUP_CRON_SCHEDULE=0 2 * * *

# [OPTIONAL] Backup retention threshold in days. Archives older than this are safely pruned.
# Default: 30. Latest backup is always preserved regardless of age.
DATABASE_BACKUP_RETENTION_DAYS=30

# [OPTIONAL] Target email address to receive critical backup failure alerts.
DATABASE_BACKUP_ALERT_EMAIL=devops-alerts@schoolname.edu

# ------------------------------------------------------------------------------
# 8. SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
# [OPTIONAL] Global API throttler limit (requests per minute per IP). Default: 120.
THROTTLE_LIMIT=120
THROTTLE_TTL=60
