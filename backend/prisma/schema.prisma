datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_SUPER_ADMIN
  SCHOOL_ADMIN
  FEE_STAFF
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED
  ALUMNI
}

enum FeeHeadCategory {
  ACADEMIC
  FACILITY
  INSTITUTIONAL
  ACTIVITY
  MISCELLANEOUS
}

enum FeeHeadStatus {
  ACTIVE
  INACTIVE
}

enum FeeFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum FeeStructureStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ConcessionType {
  NONE
  PERCENTAGE
  FLAT_DISCOUNT
}

enum AllocationStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  UPCOMING
  DUE
  OVERDUE
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  POS_CARD
  DEMAND_DRAFT
  OTHER
}

enum PaymentStatus {
  COMPLETED
  VOIDED
  BOUNCED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum AllocationType {
  PRINCIPAL
  FINE
  REVERSAL
}

enum ReceiptStatus {
  ACTIVE
  CANCELLED
}

enum ReversalType {
  VOID
  BOUNCE
  CORRECTION
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AssessedFineStatus {
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  WAIVED
}

enum FineType {
  FIXED
  PER_DAY
  PERCENTAGE
}

enum FineDayCountPolicy {
  CALENDAR_DAYS
  WORKING_DAYS
}

enum FineRuleStatus {
  ACTIVE
  INACTIVE
}

// -------------------------------------------------------------
// Core Multi-Tenant Foundation: School / Tenant
// -------------------------------------------------------------
model School {
  id        String       @id @default(uuid())
  code      String       @unique // e.g. "SCH001"
  name      String
  address   String?
  city      String?
  state     String?
  country   String       @default("IN")
  currency  String       @default("INR")
  timezone  String       @default("Asia/Kolkata")
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                     User[]
  academicYears             AcademicYear[]
  grades                    GradeClass[]
  sections                  Section[]
  students                  Student[]
  feeHeads                  FeeHead[]
  feeStructures             FeeStructure[]
  feeStructureItems         FeeStructureItem[]
  studentFeeAllocations     StudentFeeAllocation[]
  invoices                  FeeInvoice[]
  invoiceItems              InvoiceItem[]
  feeGenerationRuns         FeeGenerationRun[]
  parentStudentRelations    ParentStudentRelation[]
  studentOneTimeFeeBillings StudentOneTimeFeeBilling[]
  fineRules                 FineRule[]
  payments                  Payment[]
  paymentAllocations        PaymentAllocation[]
  receiptSequenceCounters   ReceiptSequenceCounter[]
  assessedFines             AssessedFine[]
  fineWaivers               FineWaiver[]
  receipts                  Receipt[]
  paymentRefunds            PaymentRefund[]
  paymentRefundAllocations  PaymentRefundAllocation[]
  paymentReversals          PaymentReversal[]
  reversalSequenceCounters  ReversalSequenceCounter[]

  @@map("schools")
}

// -------------------------------------------------------------
// Users: Platform Super Admins, School Admins, Staff, Students, Parents
// -------------------------------------------------------------
model User {
  id           String     @id @default(uuid())
  schoolId     String? // Nullable strictly for PLATFORM_SUPER_ADMIN
  email        String
  passwordHash String
  name         String
  role         UserRole   @default(FEE_STAFF)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  school                     School?                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorizedAllocations      StudentFeeAllocation[]
  feeGenerationRuns          FeeGenerationRun[]
  studentProfile             Student?                @relation("StudentUserAccount")
  parentRelations            ParentStudentRelation[]
  createdFineRules           FineRule[]              @relation("FineRuleCreatedBy")
  updatedFineRules           FineRule[]              @relation("FineRuleUpdatedBy")
  collectedPayments          Payment[]               @relation("PaymentCollectedBy")
  cancelledPayments          Payment[]               @relation("PaymentCancelledBy")
  authorizedFineWaivers      FineWaiver[]            @relation("FineWaiverAuthorizedBy")
  authorizedRefunds          PaymentRefund[]         @relation("PaymentRefundAuthorizedBy")
  processedRefunds           PaymentRefund[]         @relation("PaymentRefundProcessedBy")
  authorizedPaymentReversals PaymentReversal[]       @relation("PaymentReversalAuthorizedBy")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("users")
}

// -------------------------------------------------------------
// Academic Sessions / Years
// -------------------------------------------------------------
model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  name      String // e.g. "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                  School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students                Student[]
  feeStructures           FeeStructure[]
  studentFeeAllocations   StudentFeeAllocation[]
  invoices                FeeInvoice[]
  feeGenerationRuns       FeeGenerationRun[]
  oneTimeBillings         StudentOneTimeFeeBilling[]
  fineRules               FineRule[]
  payments                Payment[]
  receiptSequenceCounters ReceiptSequenceCounter[]
  receipts                Receipt[]
  reversalSequenceCounters ReversalSequenceCounter[]

  @@unique([schoolId, name])
  @@unique([schoolId, id]) // Required for composite foreign key constraint
  @@index([schoolId])
  @@map("academic_years")
}

// -------------------------------------------------------------
// Academic Grade / Class Structure
// -------------------------------------------------------------
model GradeClass {
  id        String   @id @default(uuid())
  schoolId  String
  name      String // e.g. "Grade 10"
  code      String // e.g. "G10"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections      Section[]
  students      Student[]
  feeStructures FeeStructure[]

  @@unique([schoolId, code])
  @@unique([schoolId, id]) // Required for composite foreign key constraint
  @@index([schoolId])
  @@map("grade_classes")
}

// -------------------------------------------------------------
// Class Sections
// -------------------------------------------------------------
model Section {
  id        String   @id @default(uuid())
  schoolId  String
  gradeId   String
  name      String // e.g. "A"
  capacity  Int      @default(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Composite foreign key: Guarantees grade belongs to the EXACT same school
  grade    GradeClass @relation(fields: [schoolId, gradeId], references: [schoolId, id], onDelete: Cascade)
  students Student[]

  @@unique([schoolId, gradeId, name])
  @@unique([schoolId, id]) // Required for composite foreign key constraint
  @@index([schoolId])
  @@index([gradeId])
  @@map("sections")
}

// -------------------------------------------------------------
// Student Profiles
// -------------------------------------------------------------
model Student {
  id              String        @id @default(uuid())
  schoolId        String
  admissionNumber String
  rollNumber      String?
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  guardianName    String?
  guardianPhone   String?
  guardianEmail   String?
  gradeId         String
  sectionId       String
  academicYearId  String
  admissionDate   DateTime? // Mid-year admission date (if null, assumed beginning of session)
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school          School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Composite foreign keys: Impossible for a student in School A to link to grade/section/session of School B
  grade           GradeClass                 @relation(fields: [schoolId, gradeId], references: [schoolId, id], onDelete: Cascade)
  section         Section                    @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Cascade)
  academicYear    AcademicYear               @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)
  userId          String?                    @unique
  userAccount     User?                      @relation("StudentUserAccount", fields: [userId], references: [id], onDelete: SetNull)
  feeAllocations  StudentFeeAllocation[]
  invoices        FeeInvoice[]
  parentRelations ParentStudentRelation[]
  oneTimeBillings StudentOneTimeFeeBilling[]
  payments        Payment[]

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([gradeId])
  @@index([sectionId])
  @@index([academicYearId])
  @@map("students")
}

// =============================================================
// PHASE 2B: FEE CONFIGURATION TIER
// =============================================================

// -------------------------------------------------------------
// Fee Head: Catalog of charges per school
// -------------------------------------------------------------
model FeeHead {
  id          String          @id @default(uuid())
  schoolId    String
  name        String // e.g. "Tuition Fee", "Transport Fee"
  code        String // e.g. "TUIT", "TRN"
  description String?
  category    FeeHeadCategory @default(ACADEMIC)
  isOptional  Boolean         @default(false) // e.g. transport is optional
  status      FeeHeadStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  school          School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structureItems  FeeStructureItem[]
  invoiceItems    InvoiceItem[]
  oneTimeBillings StudentOneTimeFeeBilling[]
  fineRules       FineRule[]

  @@unique([schoolId, code])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("fee_heads")
}

// -------------------------------------------------------------
// Fee Structure: Class & Academic Year Master Template
// -------------------------------------------------------------
model FeeStructure {
  id             String             @id @default(uuid())
  schoolId       String
  academicYearId String
  gradeId        String
  name           String // e.g. "Grade 10 General Fee 2026-2027"
  description    String?
  status         FeeStructureStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear           @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)
  grade        GradeClass             @relation(fields: [schoolId, gradeId], references: [schoolId, id], onDelete: Cascade)
  items        FeeStructureItem[]
  allocations  StudentFeeAllocation[]

  @@unique([schoolId, academicYearId, gradeId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([gradeId])
  @@index([academicYearId])
  @@map("fee_structures")
}

// -------------------------------------------------------------
// Fee Structure Item: Item Breakdown within a Structure
// -------------------------------------------------------------
model FeeStructureItem {
  id             String       @id @default(uuid())
  schoolId       String
  feeStructureId String
  feeHeadId      String
  amount         Decimal      @db.Decimal(12, 2)
  frequency      FeeFrequency @default(MONTHLY)
  isOptional     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [schoolId, feeStructureId], references: [schoolId, id], onDelete: Cascade)
  // Composite foreign key to FeeHead: strictly enforces same school
  // onDelete: Restrict prevents deleting fee head while used in a structure
  feeHead      FeeHead      @relation(fields: [schoolId, feeHeadId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, feeStructureId, feeHeadId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([feeStructureId])
  @@index([feeHeadId])
  @@map("fee_structure_items")
}

// -------------------------------------------------------------
// Student Fee Allocation: Enrolling Student into Fee Structure
// -------------------------------------------------------------
model StudentFeeAllocation {
  id             String           @id @default(uuid())
  schoolId       String
  studentId      String
  feeStructureId String
  academicYearId String
  status         AllocationStatus @default(ACTIVE)

  // Concession / Discount Policy (At most 1 concession per student allocation)
  concessionType     ConcessionType @default(NONE)
  concessionValue    Decimal        @default(0.00) @db.Decimal(12, 2)
  concessionReason   String?
  authorizedByUserId String?

  // JSON Array of opted optional FeeHead IDs, e.g. ["fee-head-uuid-1"]
  optedFeeHeadIds Json @default("[]")

  // Mid-year admission billing start: 1 = April, 2 = May, ... 12 = March
  startBillingMonth Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [schoolId, feeStructureId], references: [schoolId, id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)
  authorizedBy User?        @relation(fields: [authorizedByUserId], references: [id], onDelete: SetNull)

  @@unique([schoolId, studentId, academicYearId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([academicYearId])
  @@map("student_fee_allocations")
}

// =============================================================
// PHASE 2C: MONTHLY FEE GENERATION & INVOICE TIER
// =============================================================

// -------------------------------------------------------------
// Fee Invoice: Monthly Student Fee Obligation
// -------------------------------------------------------------
model FeeInvoice {
  id             String        @id @default(uuid())
  schoolId       String
  studentId      String
  academicYearId String
  billingMonth   Int // 1–12, where 1 = April, 12 = March
  dueDate        DateTime
  grossAmount    Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2)
  netAmount      Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(UPCOMING)
  generatedAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  academicYear AcademicYear        @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)
  items        InvoiceItem[]
  paymentAllocations PaymentAllocation[]
  assessedFines      AssessedFine[]
  fineWaivers        FineWaiver[]

  @@unique([schoolId, studentId, academicYearId, billingMonth])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([billingMonth])
  @@index([status])
  @@map("fee_invoices")
}

// -------------------------------------------------------------
// Invoice Item: Line-Item Snapshot within Monthly Invoice
// -------------------------------------------------------------
model InvoiceItem {
  id                       String              @id @default(uuid())
  schoolId                 String
  invoiceId                String
  feeHeadId                String
  feeHeadNameSnapshot      String
  grossAmount              Decimal             @db.Decimal(12, 2)
  discountAmount           Decimal             @db.Decimal(12, 2)
  netAmount                Decimal             @db.Decimal(12, 2)
  billingFrequencySnapshot FeeFrequency
  createdAt                DateTime            @default(now())

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice            FeeInvoice          @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Cascade)
  feeHead            FeeHead             @relation(fields: [schoolId, feeHeadId], references: [schoolId, id], onDelete: Restrict)
  paymentAllocations PaymentAllocation[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([invoiceId])
  @@index([feeHeadId])
  @@map("invoice_items")
}

// -------------------------------------------------------------
// Fee Generation Run: Traceable Batch Audit History
// -------------------------------------------------------------
model FeeGenerationRun {
  id                   String   @id @default(uuid())
  schoolId             String
  academicYearId       String
  gradeId              String?
  executedByUserId     String?
  totalStudents        Int
  totalInvoicesCreated Int
  totalInvoicesSkipped Int
  totalGrossAmount     Decimal  @db.Decimal(12, 2)
  totalDiscountAmount  Decimal  @db.Decimal(12, 2)
  totalNetAmount       Decimal  @db.Decimal(12, 2)
  status               String   @default("COMPLETED")
  createdAt            DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)
  executedBy   User?        @relation(fields: [executedByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([academicYearId])
  @@map("fee_generation_runs")
}

// =============================================================
// PHASE 2C REMEDIATION: VERIFIED PARENT RELATIONS & ONE-TIME TRACKING
// =============================================================

// -------------------------------------------------------------
// Parent-to-Student Verified Relationship Mapping
// -------------------------------------------------------------
model ParentStudentRelation {
  id               String   @id @default(uuid())
  schoolId         String
  parentId         String
  studentId        String
  relationshipType String   @default("GUARDIAN") // e.g. "FATHER", "MOTHER", "GUARDIAN"
  isVerified       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, parentId, studentId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_student_relations")
}

// -------------------------------------------------------------
// Student One-Time Fee Billing Record: Prevents cross-session duplicate billing
// -------------------------------------------------------------
model StudentOneTimeFeeBilling {
  id             String   @id @default(uuid())
  schoolId       String
  studentId      String
  feeHeadId      String
  academicYearId String
  billedAt       DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [schoolId, feeHeadId], references: [schoolId, id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, studentId, feeHeadId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([studentId])
  @@index([feeHeadId])
  @@map("student_one_time_fee_billings")
}

// =============================================================
// PHASE 2D-B: FINE CONFIGURATION & LATE FINE RULES ENGINE
// =============================================================

model FineRule {
  id                  String             @id @default(uuid())
  schoolId            String
  academicYearId      String
  name                String
  description         String?
  fineType            FineType           @default(FIXED)
  fineValue           Decimal            @db.Decimal(12, 2)
  gracePeriodDays     Int                @default(5)
  maxFineCap          Decimal?           @db.Decimal(12, 2)
  dayCountPolicy      FineDayCountPolicy @default(CALENDAR_DAYS)
  applicableFeeHeadId String?
  applicableCategory  FeeHeadCategory?
  effectiveStartDate  DateTime?
  effectiveEndDate    DateTime?
  status              FineRuleStatus     @default(ACTIVE)
  createdByUserId     String?
  updatedByUserId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)
  applicableFeeHead FeeHead?     @relation(fields: [schoolId, applicableFeeHeadId], references: [schoolId, id], onDelete: Restrict)
  createdBy         User?          @relation("FineRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy         User?          @relation("FineRuleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  assessedFines     AssessedFine[]

  @@unique([schoolId, academicYearId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([status])
  @@index([applicableFeeHeadId])
  @@map("fine_rules")
}

// =============================================================
// PHASE 2E: PAYMENT COLLECTION, ALLOCATION & RECEIPTS TIER
// =============================================================

// -------------------------------------------------------------
// Receipt Sequence Counter: Atomic Monotonic Sequence Tracker
// -------------------------------------------------------------
model ReceiptSequenceCounter {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  prefix         String       @default("RCT")
  nextSequence   Int          @default(1)
  updatedAt      DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, academicYearId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("receipt_sequence_counters")
}

// -------------------------------------------------------------
// Reversal Sequence Counter: Atomic Monotonic Sequence Tracker for Reversals
// -------------------------------------------------------------
model ReversalSequenceCounter {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  prefix         String       @default("REV")
  nextSequence   Int          @default(1)
  updatedAt      DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, academicYearId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("reversal_sequence_counters")
}

// -------------------------------------------------------------
// Payment: Transaction Master Record
// -------------------------------------------------------------
model Payment {
  id                 String        @id @default(uuid())
  schoolId           String
  studentId          String
  academicYearId     String
  paymentNumber      String        // e.g. "PAY-2026-00001"
  paymentDate        DateTime      @default(now())
  amount             Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(CASH)
  referenceNumber    String?       // UTR, UPI transaction ref, bank deposit ref
  chequeNumber       String?
  chequeDate         DateTime?
  bankName           String?
  notes              String?
  status             PaymentStatus @default(COMPLETED)
  idempotencyKey     String?
  requestHash        String?       // SHA-256 hash of canonical request payload
  collectedByUserId  String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student             @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  academicYear    AcademicYear        @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)
  collectedByUser User?               @relation("PaymentCollectedBy", fields: [collectedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?               @relation("PaymentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]
  receipt         Receipt?
  refunds         PaymentRefund[]
  reversals       PaymentReversal[]

  @@unique([schoolId, paymentNumber])
  @@unique([schoolId, idempotencyKey])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

// -------------------------------------------------------------
// Payment Allocation: Line-Item & Fine Settlement Ledger
// -------------------------------------------------------------
model PaymentAllocation {
  id                     String             @id @default(uuid())
  schoolId               String
  paymentId              String
  invoiceId              String
  invoiceItemId          String?            // Null if allocation is for a late fine
  assessedFineId         String?            // Null if allocation is for base fee item
  reversalOfAllocationId String?            // References original allocation if this is a reversal
  paymentReversalId      String?            // References PaymentReversal master record if this is a reversal
  allocationType         AllocationType     @default(PRINCIPAL)
  allocatedAmount        Decimal            @db.Decimal(12, 2)
  createdAt              DateTime           @default(now())

  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment         Payment             @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)
  invoice         FeeInvoice          @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Restrict)
  invoiceItem     InvoiceItem?        @relation(fields: [schoolId, invoiceItemId], references: [schoolId, id], onDelete: Restrict)
  assessedFine    AssessedFine?       @relation(fields: [schoolId, assessedFineId], references: [schoolId, id], onDelete: Restrict)
  reversalOf      PaymentAllocation?  @relation("AllocationReversals", fields: [schoolId, reversalOfAllocationId], references: [schoolId, id], onDelete: Restrict)
  reversals         PaymentAllocation[]       @relation("AllocationReversals")
  paymentReversal   PaymentReversal?          @relation(fields: [schoolId, paymentReversalId], references: [schoolId, id], onDelete: Restrict)
  refundAllocations PaymentRefundAllocation[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([invoiceItemId])
  @@index([assessedFineId])
  @@index([reversalOfAllocationId])
  @@index([paymentReversalId])
  @@map("payment_allocations")
}

// -------------------------------------------------------------
// Assessed Fine: Frozen Late Fine Obligation
// -------------------------------------------------------------
model AssessedFine {
  id                  String             @id @default(uuid())
  schoolId            String
  invoiceId           String
  fineRuleId          String?
  assessedAmount      Decimal            @db.Decimal(12, 2)
  asOfDate            DateTime
  overdueDays         Int
  status              AssessedFineStatus @default(OUTSTANDING)
  calculationSnapshot Json
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice     FeeInvoice          @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Restrict)
  fineRule    FineRule?           @relation(fields: [schoolId, fineRuleId], references: [schoolId, id], onDelete: Restrict)
  allocations PaymentAllocation[]
  waivers     FineWaiver[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([invoiceId])
  @@index([status])
  @@index([fineRuleId])
  @@map("assessed_fines")
}

// -------------------------------------------------------------
// Fine Waiver: Authorized Forgiveness Record
// -------------------------------------------------------------
model FineWaiver {
  id                 String        @id @default(uuid())
  schoolId           String
  invoiceId          String
  assessedFineId     String?
  waivedAmount       Decimal       @db.Decimal(12, 2)
  reason             String
  authorizedByUserId String?
  createdAt          DateTime      @default(now())

  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice          FeeInvoice    @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Restrict)
  assessedFine     AssessedFine? @relation(fields: [schoolId, assessedFineId], references: [schoolId, id], onDelete: Restrict)
  authorizedByUser User?         @relation("FineWaiverAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([invoiceId])
  @@index([assessedFineId])
  @@map("fine_waivers")
}

// -------------------------------------------------------------
// Receipt: Sequential Audit-Proof Document
// -------------------------------------------------------------
model Receipt {
  id              String        @id @default(uuid())
  schoolId        String
  paymentId       String        @unique
  receiptNumber   String        // e.g. "RCT-202627-00104"
  receiptSequence Int           // Monotonic counter per school and academic year
  academicYearId  String
  issuedDate      DateTime      @default(now())
  totalAmount     Decimal       @db.Decimal(12, 2)
  status          ReceiptStatus @default(ACTIVE)
  receiptSnapshot Json          // Frozen JSON snapshot of student, line items, cashier, etc.
  createdAt       DateTime      @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, paymentId])
  @@unique([schoolId, receiptNumber])
  @@unique([schoolId, academicYearId, receiptSequence])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([issuedDate])
  @@map("receipts")
}

// -------------------------------------------------------------
// Payment Refund: Reversal & Refund Audit Entry
// -------------------------------------------------------------
model PaymentRefund {
  id                 String       @id @default(uuid())
  schoolId           String
  paymentId          String
  refundAmount       Decimal      @db.Decimal(12, 2)
  refundDate         DateTime     @default(now())
  reason             String
  authorizedByUserId String?
  processedByUserId  String?
  processedAt        DateTime?
  failureReason      String?
  mode               String       @default("CASH")
  status             RefundStatus @default(SUCCEEDED)
  referenceNumber    String?      // e.g. bank transfer UTR or refund voucher number
  idempotencyKey     String?
  requestHash        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  school           School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment          Payment                   @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)
  authorizedByUser User?                     @relation("PaymentRefundAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: SetNull)
  processedByUser  User?                     @relation("PaymentRefundProcessedBy", fields: [processedByUserId], references: [id], onDelete: SetNull)
  allocations      PaymentRefundAllocation[]

  @@unique([schoolId, id])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([paymentId])
  @@index([status])
  @@map("payment_refunds")
}

// -------------------------------------------------------------
// Payment Refund Allocation: Line-Item Mapping to Original Allocations
// -------------------------------------------------------------
model PaymentRefundAllocation {
  id                   String   @id @default(uuid())
  schoolId             String
  paymentRefundId      String
  originalAllocationId String
  amount               Decimal  @db.Decimal(12, 2)
  createdAt            DateTime @default(now())

  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  paymentRefund      PaymentRefund     @relation(fields: [schoolId, paymentRefundId], references: [schoolId, id], onDelete: Cascade)
  originalAllocation PaymentAllocation @relation(fields: [schoolId, originalAllocationId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([paymentRefundId])
  @@index([originalAllocationId])
  @@map("payment_refund_allocations")
}

// -------------------------------------------------------------
// Payment Reversal: Master Audit Record for Compensating Ledger Entries
// -------------------------------------------------------------
model PaymentReversal {
  id                 String       @id @default(uuid())
  schoolId           String
  paymentId          String
  reversalNumber     String       // e.g. "REV-202627-00001"
  reversalType       ReversalType @default(VOID)
  totalAmount        Decimal      @db.Decimal(12, 2)
  reason             String
  authorizedByUserId String?
  idempotencyKey     String?
  requestHash        String?
  createdAt          DateTime     @default(now())

  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment          Payment             @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)
  authorizedByUser User?               @relation("PaymentReversalAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: SetNull)
  allocations      PaymentAllocation[]

  @@unique([schoolId, id])
  @@unique([schoolId, reversalNumber])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([paymentId])
  @@index([reversalType])
  @@map("payment_reversals")
}
